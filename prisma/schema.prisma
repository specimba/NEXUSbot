generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// L0 event stream — single append-mostly table. One row = one normalized event.
model Event {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  source    String // kick | userscript | agent | system | connector
  type      String // dot-namespaced, e.g. viewer.join / bot.command / eval.gate
  level     String   @default("info") // debug | info | warn | error
  actor     String?
  payload   String   @default("{}") // JSON string, clamped to 8 KiB at ingest
  createdAt DateTime @default(now())

  @@index([ts])
  @@index([source, type])
}

// Secrets vault — values encrypted by src/lib/crypto.ts (AES-256-GCM, versioned envelope).
// Plaintext never leaves this table except transiently in-process for use/masking.
model Credential {
  id        String   @id @default(cuid())
  service   String // github | supabase | upstash | hyperbrowser | webshare
  label     String   @default("default")
  keyId     String // sha256(keyMaterial) first 8 hex — for rotation windows
  cipher    String // envelope: v1.<keyId>.<iv>.<tag>.<ct> (base64url parts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([service, label])
}

// Ingest tokens for L0 write path (widget / userscript / automations).
// Only sha256 hashes are stored; the plaintext token is shown ONCE at creation.
model IngestToken {
  id         String    @id @default(cuid())
  label      String
  tokenHash  String    @unique
  preview    String // first 8 chars + "…" for UI identification
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// Generic owner-scoped settings (budgets, feature gates). Whitelisted keys only.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Self-hosted widget system (Kickbot-builder parity, but ours): a widget is a
// self-contained HTML/CSS/JS bundle plus typed user variables. Rendered in the
// panel preview via iframe srcDoc and exported as a single-file OBS browser
// source (local-first — no hosted widget URL, nothing leaves the sandbox).
model Widget {
  id        String   @id @default(cuid())
  name      String
  width     Int      @default(560)
  height    Int      @default(260)
  html      String   @default("")
  css       String   @default("")
  js        String   @default("")
  variables String   @default("[]") // JSON array: [{name,label,type,value,secret}]
  enabled   Boolean  @default(true)
  seeded    Boolean  @default(false) // true for the Cyber AI Counter import (provenance)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stable OBS Browser Source link. The old flow minted a fresh ingest token
  // per click and kept the URL only in React state — every panel refresh
  // produced a DIFFERENT URL. Now the link is durable:
  //   obsTokenId    — IngestToken row backing the link (revocable/resettable)
  //   obsLinkCipher — vault-encrypted "/api/widgets/<id>/stream?token=<plain>"
  //                   (origin-independent: only the host part can ever change)
  //   obsBaseUrl    — host anchor, e.g. "http://localhost:3000" (OBS on the
  //                   same machine as the panel). null → follow current origin.
  obsTokenId    String?
  obsLinkCipher String?
  obsBaseUrl    String?
}

// Owner-defined brain providers beyond Vyce/Groq: OpenAI-compatible or
// Anthropic-compatible gateways with explicit endpoint + model. Keys are
// encrypted with the same AES-256-GCM envelope as the Credential vault.
model CustomProvider {
  id              String    @id @default(cuid())
  name            String
  protocol        String // "openai" | "anthropic"
  baseUrl         String // https://… (may or may not end with /v1 — normalized at call time)
  model           String    @default("") // default model id for brain calls
  models          String    @default("[]") // JSON array of ALL model ids (batch add); `model` is the default/first
  keyId           String    @default("") // sha256(keyMaterial) first 8 hex — "" when no key yet
  keyCipher       String    @default("") // crypto.ts envelope; "" when no key yet
  enabled         Boolean   @default(true)
  lastProbeAt     DateTime?
  lastProbeOk     Boolean?
  lastProbeDetail String    @default("") // static probe verdict (never key material)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// L0 brain pipeline log (v29.8) — ONE row per !ai interaction, full-fidelity
// for evaluation / training / security review. This is the owner's explicit
// ask: log interactions AND responses inside the pipeline catch.
model InteractionLog {
  id               String   @id @default(cuid())
  channel          String   @default("specimba")
  username         String // Kick sender handle (lowercased for queries)
  displayHandle    String   @default("") // original case handle
  command          String   @default("ai") // ai | model | credits | imagine | reset | …
  message          String   @default("") // viewer prompt (clamped 2k)
  response         String   @default("") // brain reply (clamped 2k)
  model            String   @default("") // deepseek-v4-flash-lr | GPT-OSS 120B | …
  modelId          String   @default("") // raw model id when known
  provider         String   @default("") // vyce | groq | edge | direct | none
  route            String   @default("") // primary | fallback:oss-120b | circuit-open | …
  status           String   @default("ok") // ok | direct | refused | busy | error | timeout
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  webUsed          Boolean  @default(false) // server research snippets attached
  flags            String   @default("[]") // JSON array of technique ids (NexusGuard)
  injectionScore   Int      @default(0) // 0..3 severity
  memoryUsed       Boolean  @default(false) // server dialogue ladder was attached
  error            String   @default("")
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([username, createdAt])
  @@index([status, createdAt])
}

// Security memory (v29.8) — learned caveats from viewer abuse attempts.
// Upserted by /api/brain/log whenever NexusGuard flags a message; the most
// recent/heaviest lessons are injected into the system prompt so the brain
// keeps refusing the same rookie techniques consistently (owner ask:
// "small learning caveats for our AI to improve security memory").
model SecurityLesson {
  id         String   @id @default(cuid())
  technique  String // FAKE_AUTHORITY | PROMPT_INJECTION | RESET_ATTEMPT | SECRET_FISHING | FLOOD_ABUSE | COMMAND_ABUSE
  username   String   @default("") // lowercased handle, "" when unknown
  snippet    String   @default("") // redacted 120-char excerpt of the attempt
  counter    String   @default("") // what the brain answered (first refusal)
  hits       Int      @default(1)
  severity   Int      @default(1) // 1..3
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([technique, username])
  @@index([lastSeenAt])
}

// Usage ledger (T-207) — counters only, NEVER prompt/response content (P7).
// kind "image" rows are the ONLY user-facing credit surface (grok-imagine
// creations, charged per print, not per electricity); kind "llm" rows are
// internal telemetry (model, latency, tokens-if-reported, ok) and are never
// surfaced as user-facing cost. meta holds static scalar fields only
// (httpStatus, error code, role) — redacted via src/lib/ai/client.ts.
model UsageEvent {
  id         String   @id @default(cuid())
  ts         DateTime @default(now())
  kind       String // "image" | "llm"
  model      String
  userHandle String? // @username for IMAGE credits only
  credits    Float    @default(0)
  ok         Boolean  @default(true)
  latencyMs  Int?
  meta       String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([ts])
  @@index([kind, userHandle])
}

// ---------------------------------------------------------------------------
// v35 RSI Lab — L3 frozen eval suites + L4 gated evolution cycles
// (owner directive 2026-10-29: "start the eval modules and structures …
// RSI harness evolution with smart evolution upgrade cycles").
//
// Honesty contract (docs/scope.md L3/L4, docs/verify.md addendum):
// - RsiSuite/RsiTask rows are FROZEN once seeded (configHash-sealed); the
//   engine never writes to them — the AUDIT stage re-checks every hash.
// - Every RsiRun metric is live-measured; failures are stored as failures.
// - Promotion (RsiPlugin status "adopted") requires the owner gate; deploy
//   remains a manual Edge Cortex Deploy action — nothing auto-deploys.
// ---------------------------------------------------------------------------

// L3 paper library — the owner's curated RSI corpus (48 papers, seeded from
// rsi-lab-research/curation-papers.json; all entries web-abstract evidence).
model RsiPaper {
  id           String   @id @default(cuid())
  citeKey      String   @unique
  title        String
  authorsShort String
  year         Int
  arxivId      String
  url          String
  category     String // harness-evolution | verification-eval | efficiency-substrate | safety-governance | training-methods
  relevance    String // core | supporting | peripheral
  oneLine      String
  keyTechnique String
  appliesTo    String
  evidence     String
  createdAt    DateTime @default(now())

  @@index([category])
}

// L3 frozen suite (v1.0). Seeded once from eval-design.json suiteBlueprints;
// never overwritten by key — tamper-evidence via configHash re-check at AUDIT.
model RsiSuite {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  category    String // capability | research-grounding | safety | reliability | harness-discipline
  description String
  grounding   String
  version     String    @default("1.0")
  configHash  String // sha256 over canonical JSON of ordered task configs
  frozenAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  tasks       RsiTask[]
  runs        RsiRun[]
}

model RsiTask {
  id             String  @id @default(cuid())
  suiteId        String
  suite          RsiSuite @relation(fields: [suiteId], references: [id])
  idx            Int
  name           String
  prompt         String
  verifier       String // one of the 12 frozen verifier type ids
  verifierConfig String  @default("{}") // JSON per eval-design.json verifierTypes
  difficulty     Int     @default(3) // 1-5
  weight         Float   @default(1) // 0-1
  tags           String  @default("[]") // JSON string array (SQLite: no list primitives)
}

// Candidate prompt-delta module (PluginRSI-style atomized row). The persona
// under test = baseline snapshot + adopted/active promptDelta only.
model RsiPlugin {
  id          String   @id @default(cuid())
  name        String
  kind        String   @default("prompt-delta")
  payload     String   @default("{}") // JSON: {promptDelta?, notes, inspirationArxiv[]}
  description String   @default("")
  sourceArxiv String   @default("")
  status      String   @default("draft") // draft | active | adopted | rejected
  cycleId     String?
  createdAt   DateTime @default(now())

  @@index([status])
}

// L4 evolution cycle — 9 stages scout→record, terminal adopted|rejected|aborted.
model RsiCycle {
  id               String          @id @default(cuid())
  name             String
  thesis           String
  techniqueRefs    String          @default("[]") // JSON arxivIds resolved against RsiPaper
  status           String          @default("scout")
  stageData        String          @default("{}") // JSON per-stage scratch (scout counts, run ids, canary, module, …)
  baselineSnapshot String          @default("") // persona/system prompt at creation (attributable baselines)
  pluginId         String?
  suiteIds         String          @default("[]") // JSON suite ids used for shadow-eval
  gateResults      String          @default("{}") // JSON G1/G2/G3/G5/G7 verdicts with real numbers
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           RsiCycleEvent[]

  @@index([status, updatedAt])
}

// Append-only hash-chained cycle ledger: seq per cycle, eventHash =
// sha256(prevHash + canonical_json(payload)) — replay-verified at AUDIT.
model RsiCycleEvent {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     RsiCycle @relation(fields: [cycleId], references: [id])
  seq       Int
  stage     String
  type      String
  payload   String   @default("{}")
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@unique([cycleId, seq])
}

// One paired eval battery execution (baseline or candidate leg) on one suite.
model RsiRun {
  id             String   @id @default(cuid())
  cycleId        String?
  suiteId        String
  suite          RsiSuite @relation(fields: [suiteId], references: [id])
  variant        String // baseline | candidate
  pluginId       String?
  status         String   @default("queued") // queued | running | done | error
  passRate       Float?
  judgeAvg       Float?
  abstainRate    Float?
  latencyP50Ms   Int?
  latencyP95Ms   Int?
  tokensAvg      Int?
  costUnits      Float?
  compositeScore Float?
  resultsJson    String   @default("[]") // per-task verdicts (replyExcerpt capped, engine truth)
  engineJson     String   @default("{}") // {provider, modelId} truth per v34.1 convention
  error          String   @default("")
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Adopted-technique causal record (Causal Improvement Graph-style edges).
model RsiImprovementEdge {
  id        String   @id @default(cuid())
  cycleId   String
  technique String
  metric    String
  before    Float
  after     Float
  createdAt DateTime @default(now())
}
