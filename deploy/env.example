# NEXUS OS — environment template (deploy kit)
# Copy to data/.env on the target host, or let vm-setup.sh generate it.
# Values below are placeholders (safe for the repo scan by design).

# SQLite database file. Absolute path on the persistent volume:
DATABASE_URL=file:/opt/nexus/data/custom.db

# Durability-critical secrets. Generate on the host with:
#   openssl rand -base64 48
# The sandbox seal restore overwrites these with the sealed originals after
# panel -> Settings -> Sandbox seal -> Restore.
PANEL_PASSWORD="REPLACE ME"
SESSION_SECRET="REPLACE ME"
ENCRYPTION_KEY="REPLACE ME"
# ENCRYPTION_KEYS_PREV="REPLACE ME"   # only after a manual key rotation

# Port for the Next.js production server (Caddy proxies 443 -> this)
PORT=3000
